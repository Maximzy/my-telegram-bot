# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=your_telegram_user_id
ADMIN_PASSWORD=your_admin_password

# ── Server ──
PORT=8080
# URL where your mini app is accessible (Cloudflare tunnel or domain)
WEBAPP_URL=https://your-tunnel-url.trycloudflare.com/app

# ── Monobank (Personal API) ──
# Get token at https://api.monobank.ua/ (personal API)
MONOBANK_TOKEN=your_monobank_personal_token
# Card number visible to users for payment
PAYMENT_CARD=4400000000000000
MONOBANK_CARD=4400000000000000
# Account ID from /personal/client-info response
MONOBANK_ACCOUNT_ID=your_account_id

# ── FazerCards (B2B UC delivery) ──
FAZERCARDS_API_KEY=your_fazercards_api_key
FAZERCARDS_BASE_URL=https://api.fazercards.com
FAZERCARDS_WEBHOOK_SECRET=your_webhook_secret
FAZERCARDS_MIN_BALANCE=50
FAZERCARDS_PUBG_CATEGORY=pubg

# ── Shop ──
SHOP_TAG=your_shop_tag
STARS_RATE=0.81
